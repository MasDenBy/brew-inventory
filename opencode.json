{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "brew_inventory": {
        "type": "local",
        "cwd": "mcp-server",
        "command": [
          "npx",
          "tsx",
          "src/index.ts"
        ]
      }
    }
  },
    "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
	"models": {
		"google/gemma-4-e4b": {
			"name": "google/gemma-4-e4b",
            "plan_enabled": true
        }
    }
    }
  }
}