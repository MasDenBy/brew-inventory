# Copy this file to .env and fill in your values.
# The Brewfather settings are mapped to the app's "Brewfather" configuration
# section (double underscore = nested section).

# Host port the app is exposed on (defaults to 5000)
PORT=5000

# Brewfather API credentials (https://docs.brewfather.app/api)
Brewfather__UserId=
Brewfather__ApiKey=
Brewfather__BaseUrl=https://api.brewfather.app/v2/
